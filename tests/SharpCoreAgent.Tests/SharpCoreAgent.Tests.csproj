<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Features>$(Features);runtime-async=on</Features>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Test names are documentation; CS1591 on every helper would be noise. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpCoreAgent.Domain\SharpCoreAgent.Domain.csproj" />
    <ProjectReference Include="..\..\src\SharpCoreAgent.Application\SharpCoreAgent.Application.csproj" />
    <ProjectReference Include="..\..\src\SharpCoreAgent.Infrastructure\SharpCoreAgent.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\SharpCoreAgent.DependencyInjection\SharpCoreAgent.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\SharpCoreAgent.Cli\SharpCoreAgent.Cli.csproj" />
    <ProjectReference Include="..\..\src\SharpCoreAgent.Indexing\SharpCoreAgent.Indexing.csproj" />
    <ProjectReference Include="..\..\src\SharpCoreAgent.Languages.FSharp\SharpCoreAgent.Languages.FSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The retrieval-quality corpus is data, not code: `RetrievalQualityTests` copies it into a throwaway
      workspace and indexes it there, so it must travel next to the test assembly instead of compiling into it.
      `%(RecursiveDir)` keeps the folder shape, which is what the seeded questions expect to see.
    -->
    <Compile Remove="Indexing\Fixtures\Corpus\**\*.cs" />
    <None
      Include="Indexing\Fixtures\Corpus\**\*.cs"
      Link="Indexing\Fixtures\Corpus\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpCoreAgent.TestMcpServer\SharpCoreAgent.TestMcpServer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyProductCli" AfterTargets="Build">
    <!--
      `McpServerDogfoodTests` starts `mcp serve` as a child process, exactly as `mcp config` tells another agent to.
      It launches the CLI from this folder rather than from `src` so the binary under test is the one this build just
      produced, and so the launch is a path a user could type. The whole output travels, not just the assembly: the
      apphost needs its `runtimeconfig.json` and `deps.json` beside it.
    -->
    <ItemGroup>
      <_ProductCliFiles Include="$(MSBuildThisFileDirectory)..\..\src\SharpCoreAgent.Cli\bin\$(Configuration)\net11.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProductCliFiles)" DestinationFolder="$(OutDir)Cli\%(RecursiveDir)" SkipUnchangedFiles="true" />

    <!--
      A manual `sharpcoreagent index` run in the CLI's own output folder leaves an index behind it. That is somebody's
      workspace data rather than build output, and a test that found one here would be reading the wrong index.
    -->
    <RemoveDir Directories="$(OutDir)Cli\.sharpcoreagent" />
  </Target>

  <Target Name="CopyTestMcpServer" AfterTargets="Build">
    <!--
      After Build, so the referenced project has already produced its output. The tests launch this server as a
      child process from their own folder, which is why it is copied rather than referenced as a library.
    -->
    <ItemGroup>
      <_TestMcpServerFiles Include="$(MSBuildThisFileDirectory)..\SharpCoreAgent.TestMcpServer\bin\$(Configuration)\net11.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TestMcpServerFiles)" DestinationFolder="$(OutDir)McpServer\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!--
      xUnit v3 on Microsoft.Testing.Platform, with MTP's coverage extension, so `dotnet test` can write a
      Cobertura report through a platform switch rather than a VSTest data collector. SonarCloud reads it.
    -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test code is held to the same Sonar rules; the scanner analyses it either way. -->
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
