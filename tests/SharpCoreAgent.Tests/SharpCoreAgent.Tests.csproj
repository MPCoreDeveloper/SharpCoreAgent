<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Features>$(Features);runtime-async=on</Features>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Test names are documentation; CS1591 on every helper would be noise. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpCoreAgent.Domain\SharpCoreAgent.Domain.csproj" />
    <ProjectReference Include="..\..\src\SharpCoreAgent.Application\SharpCoreAgent.Application.csproj" />
    <ProjectReference Include="..\..\src\SharpCoreAgent.Infrastructure\SharpCoreAgent.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\SharpCoreAgent.DependencyInjection\SharpCoreAgent.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\SharpCoreAgent.Cli\SharpCoreAgent.Cli.csproj" />
    <ProjectReference Include="..\..\src\SharpCoreAgent.Indexing\SharpCoreAgent.Indexing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The retrieval-quality corpus is data, not code: `RetrievalQualityTests` copies it into a throwaway
      workspace and indexes it there, so it must travel next to the test assembly instead of compiling into it.
      `%(RecursiveDir)` keeps the folder shape, which is what the seeded questions expect to see.
    -->
    <Compile Remove="Indexing\Fixtures\Corpus\**\*.cs" />
    <None
      Include="Indexing\Fixtures\Corpus\**\*.cs"
      Link="Indexing\Fixtures\Corpus\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      xUnit v3 on Microsoft.Testing.Platform, with MTP's coverage extension, so `dotnet test` can write a
      Cobertura report through a platform switch rather than a VSTest data collector. SonarCloud reads it.
    -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test code is held to the same Sonar rules; the scanner analyses it either way. -->
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
