<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SharpCoreAgent.Cli</RootNamespace>
    <AssemblyName>sharpcoreagent</AssemblyName>
    <Description>The command line: argument parsing, console rendering, approval prompts and exit codes.</Description>
    <!-- The process is the deliverable; nothing references it, so it never needs an API snapshot. -->
    <!--
      It is still a package: the .NET tool is how the process reaches a machine. `dotnet tool install -g
      sharpcoreagent` puts the command on PATH on Windows, Linux and macOS from one framework-dependent
      package (no per-RID binaries), and the command name is the one every usage string already prints.
    -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sharpcoreagent</ToolCommandName>
    <PackageId>SharpCoreAgent</PackageId>
    <PackageDescription>A terminal-first coding agent for C# / .NET: reads a repository, edits it, runs the build and the tests, and reports what it changed.</PackageDescription>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpCoreAgent.Domain\SharpCoreAgent.Domain.csproj" />
    <ProjectReference Include="..\SharpCoreAgent.Application\SharpCoreAgent.Application.csproj" />
    <ProjectReference Include="..\SharpCoreAgent.Infrastructure\SharpCoreAgent.Infrastructure.csproj" />
    <ProjectReference Include="..\SharpCoreAgent.DependencyInjection\SharpCoreAgent.DependencyInjection.csproj" />
    <ProjectReference Include="..\SharpCoreAgent.Indexing\SharpCoreAgent.Indexing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpCoreAgent.Tests" />
  </ItemGroup>

  <Target Name="CopyOcrModels" AfterTargets="Build">
    <!-- The CLI host is what ships the OCR tool; copy the bundled PP-OCRv5 models beside it. -->
    <ItemGroup>
      <_OcrModelFiles Include="$(NuGetPackageRoot)rapidocrnet\4.2.0\models\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OcrModelFiles)" DestinationFolder="$(OutDir)models\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
