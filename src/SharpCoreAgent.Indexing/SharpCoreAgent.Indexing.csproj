<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SharpCoreAgent.Indexing</RootNamespace>
    <AssemblyName>SharpCoreAgent.Indexing</AssemblyName>
    <Description>The SharpCoreDB-backed code-evidence index: schema, extraction, embeddings, retrieval and ranking. The only assembly in this repository that names a storage engine.</Description>
  </PropertyGroup>

  <!--
    Where the SharpCoreDB packages come from.

    The default is the package path: the six 2.1.2 packages restore from nuget.org, which is what
    CI and every other checkout uses, and it is the only path that proves the shipped artifacts are the
    ones the index was tested against.

    `-p:SharpCoreAgentUseLocalSharpCoreDb=true` swaps the six PackageReferences for ProjectReferences into
    a sibling checkout's src/ tree. It exists for the day the index needs an engine change that is not
    packaged yet: build both repositories without a pack-and-copy round-trip. It is not a supported
    build mode, so nothing in CI sets it.
  -->
  <PropertyGroup>
    <SharpCoreAgentUseLocalSharpCoreDb Condition="'$(SharpCoreAgentUseLocalSharpCoreDb)' == ''">false</SharpCoreAgentUseLocalSharpCoreDb>
    <SharpCoreDbRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\SharpCoreDB\'))</SharpCoreDbRepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpCoreAgent.Domain\SharpCoreAgent.Domain.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(SharpCoreAgentUseLocalSharpCoreDb)' == 'true'">
    <ProjectReference Include="$(SharpCoreDbRepoRoot)src\SharpCoreDB\SharpCoreDB.csproj" />
    <ProjectReference Include="$(SharpCoreDbRepoRoot)src\SharpCoreDB.Search\SharpCoreDB.Search.csproj" />
    <ProjectReference Include="$(SharpCoreDbRepoRoot)src\SharpCoreDB.VectorSearch\SharpCoreDB.VectorSearch.csproj" />
    <ProjectReference Include="$(SharpCoreDbRepoRoot)src\SharpCoreDB.Graph\SharpCoreDB.Graph.csproj" />
    <ProjectReference Include="$(SharpCoreDbRepoRoot)src\SharpCoreDB.Graph.Advanced\SharpCoreDB.Graph.Advanced.csproj" />
    <ProjectReference Include="$(SharpCoreDbRepoRoot)src\SharpCoreDB.HybridSearch\SharpCoreDB.HybridSearch.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(SharpCoreAgentUseLocalSharpCoreDb)' != 'true'">
    <PackageReference Include="SharpCoreDB" />
    <PackageReference Include="SharpCoreDB.Search" />
    <PackageReference Include="SharpCoreDB.VectorSearch" />
    <PackageReference Include="SharpCoreDB.Graph" />
    <PackageReference Include="SharpCoreDB.Graph.Advanced" />
    <PackageReference Include="SharpCoreDB.HybridSearch" />
  </ItemGroup>

  <!--
    No feed pre-flight check any more: the packages come from nuget.org like every other dependency, so
    a missing one is the ordinary NU1101 with an ordinary fix. The target that used to explain a local
    folder source would now only be a second, staler explanation of the same failure.
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="SharpCoreAgent.Tests" />
  </ItemGroup>

</Project>
