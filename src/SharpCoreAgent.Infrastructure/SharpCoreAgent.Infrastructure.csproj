<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SharpCoreAgent.Infrastructure</RootNamespace>
    <AssemblyName>SharpCoreAgent.Infrastructure</AssemblyName>
    <Description>HTTP transport, OpenAI-compatible wire mapping, provider adapters, the six workspace tools and the JSON session store.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpCoreAgent.Domain\SharpCoreAgent.Domain.csproj" />
    <ProjectReference Include="..\SharpCoreAgent.Application\SharpCoreAgent.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="PdfPig.Rendering.Skia" />
    <PackageReference Include="RapidOcrNet" GeneratePathProperty="true" />
    <PackageReference Include="FFMediaToolkit" />
    <PackageReference Include="FFMpeg.runtime" />
    <!--
      Logging abstractions come from the net11.0 shared framework; an explicit package reference only
      earns NU1510.
    -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpCoreAgent.Tests" />
  </ItemGroup>

  <Target Name="CopyRapidOcrModels" AfterTargets="Build">
    <!--
      RapidOcrNet puts its PP-OCRv5 Latin models under the package's `models/` folder but does not copy them into a
      consumer's output. The OCR tool resolves `models/v5` next to the assembly, so the build puts them there.
    -->
    <ItemGroup>
      <_RapidOcrModelFiles Include="$(PkgRapidOcrNet)\models\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_RapidOcrModelFiles)"
      DestinationFolder="$(OutDir)models\%(RecursiveDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
