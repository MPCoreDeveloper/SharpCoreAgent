<Project>

  <!--
    One place for every package version in the repository.

    Central package management keeps the version out of the project files: a project says what it
    needs, this file says which version satisfies it. That is what stops two projects from agreeing
    on a package name and disagreeing on its major version, the failure mode that only shows up as
    a runtime MissingMethodException much later.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!--
      One version for the four Microsoft.Extensions packages: the .NET 11 RC that the pinned SDK in
      global.json was built from. A newer one would track an SDK this repository does not pin, and an
      older one would be a .NET 10 library inside a net11.0 product.
    -->
    <DotNetExtensionsVersion>11.0.0-rc.2.26504.105</DotNetExtensionsVersion>
    <!-- One version for the six SharpCoreDB packages; see the comment on their rows below. -->
    <SharpCoreDBVersion>2.1.2</SharpCoreDBVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      DI, HTTP and logging: the only Microsoft.Extensions packages the product needs.

      The version is the .NET 11 generation on purpose, and its build number (26504.105) is the one the
      pinned SDK in global.json carries. Mixing an 11.0.0-rc.2 host with a 10.0.x extension package is
      how a net11.0 product ends up shipping a net10.0 dependency graph: it builds, and then the two
      generations disagree at runtime. This repository targets net11.0 and newer, so its dependencies
      start at that generation too.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(DotNetExtensionsVersion)" />

    <!--
      SharpCoreDB 2.1.2: the storage engine behind the code-evidence index (feature 002).
      One version for all six packages, because a mixed set would pit a vector column written by
      .VectorSearch against a planner from a different build. The packages are net11.0-only, which is
      the only framework this repository targets.

      They are published on nuget.org, so a clone restores them like any other dependency. The patch
      releases since 2.1.0 each closed a defect this index had hit: a bound float[] parameter reaches a
      VECTOR(n) column as a vector (32227696), ORDER BY vec_distance_*() LIMIT k reaches the vector
      index (16cb51d5), and a bound TEXT holding an apostrophe, a doubled quote or a backslash
      round-trips instead of landing in the neighbouring column (2.1.2, known issue 7,
      Services/SqlLiteralScanner.cs). A VECTOR(n) column read hands back float[] on the single-file
      path the index uses, so the writer binds the embedder's array directly instead of encoding it as
      JSON, and analyzer_contract moved to 3 to rebuild the cells written through the old encoding.

      The vector leg still computes cosine in C#, and the measurement behind that decision is in
      specs/002-code-evidence-index/research.md (D6): on the shipped package the repaired planner
      serves directory-mode databases only, and this index is one .scdb file, where a projected
      vec_distance_* is dropped and ORDER BY on it does not sort.
    -->
    <PackageVersion Include="SharpCoreDB" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.Search" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.VectorSearch" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.Graph" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.Graph.Advanced" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.HybridSearch" Version="$(SharpCoreDBVersion)" />

    <!--
      The F# compiler, as a library (spec 015).

      FSharp.Compiler.Service is the type checker the F# SDK itself ships; referencing it lets the agent ask
      "does this file compile, where is this symbol used, what does this call take" without starting a compiler,
      running MSBuild or restoring anything. That is the whole reason F# gets code intelligence before C# does:
      the checker is an in-process library with a documented API, not a build server to wrap.

      43.12.403 is the release that matches the F# 9 compiler in the pinned SDK, so diagnostics in the agent and
      diagnostics from `dotnet build` agree about both messages and ids. It is netstandard2.0 and brings
      FSharp.Core transitively, which is why the languages project declares no second F# dependency.
    -->
    <PackageVersion Include="FSharp.Compiler.Service" Version="43.12.403" />

    <!--
      Roslyn, linked in by SharpCoreAgent.Languages.CSharp (spec 034).

      The BCL can read C# text but cannot parse or bind it. Roslyn's CSharp.Workspaces package supplies the parser,
      compilations, semantic model and solution-wide symbol finder behind the Domain's existing language ports. It is
      not the MSBuildWorkspace package: project XML and restored assets are read directly, and asking a question starts
      no build host, MSBuild node or language server. The version is the current stable family shared by C# and
      Workspaces; splitting their versions is a MissingMethodException waiting for the one code path tests miss.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />

    <!--
      SVG rendering for the image view (spec 017 T027).

      A provider accepts PNG, JPEG, GIF and WebP, not SVG; Svg.Skia is the portable renderer that turns a vector
      file into one of those at the point it is read. SkiaSharp ships native binaries for Windows, Linux and macOS,
      which is what keeps this a cross-platform capability rather than a Windows-only one.
    -->
    <PackageVersion Include="Svg.Skia" Version="5.2.3" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.148.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.148.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="4.148.0" />

    <!--
      PDF page rendering (spec 017 T027b).

      PdfPig parses the document and PdfPig.Rendering.Skia draws a page through SkiaSharp, so a PDF becomes a PNG
      without a native PDFium/Ghostscript process. Both packages are Apache-2.0. The rendering package asks for
      SkiaSharp 3.119.4, but this repository already pins 4.148.0; the probe rendered a page through that combination
      before the dependency was added.
    -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="PdfPig.Rendering.Skia" Version="0.1.16.7" />

    <!--
      Local OCR for T026. RapidOcrNet uses ONNX PaddleOCR models and SkiaSharp; it ships the Latin models and runs
      on Windows, Linux and macOS, unlike the Windows-only Tesseract wrapper. Apache-2.0, models included.
    -->
    <PackageVersion Include="RapidOcrNet" Version="4.2.0" />

    <!--
      Audio/video metadata and frame extraction for T027c. FFMediaToolkit is MIT and binds FFmpeg 7.1 through
      FFmpeg.AutoGen; the runtime package is an LGPL build of FFmpeg itself, not a commercial codec pack. The
      runtime package covers Windows and Linux today; macOS reports the capability unavailable rather than
      silently reading a video as an image.
    -->
    <PackageVersion Include="FFMediaToolkit" Version="4.8.1" />
    <PackageVersion Include="FFMpeg.runtime" Version="7.1.3" />

    <!--
      The approved-API snapshot analyzer (constitution, Principle VII). Dev-time only:
      PrivateAssets="all" keeps it out of every package and out of a consumer's build.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />

    <!--
      The SonarCloud rule set, in the build rather than only in the cloud. Pinned to the exact build the
      scanner provisions (csharpenterprise 10.35.0.4138), so a rule cannot be an error on a laptop and
      absent in an analysis, or the other way round.
    -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />

    <!--
      xUnit v3 on the Microsoft.Testing.Platform — Microsoft's own runner, no VSTest in the graph.

      There is deliberately no `Microsoft.NET.Test.Sdk` and no `xunit.runner.visualstudio`: both exist to
      make a test project look like a VSTest project, and this one is an executable that hosts MTP
      directly (`global.json` names the runner, so `dotnet test` uses it). VSTest data collectors are
      replaced by MTP's own coverage extension, which is why the test project reports coverage with a
      flag instead of an adapter.

      Versions move together: xunit.v3 names the MTP version it hosts, and a test project on a newer
      platform than its runner is how "the tests pass locally" and "the tests vanish in CI" diverge.
    -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

</Project>
