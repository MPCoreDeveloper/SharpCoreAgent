<Project>

  <!--
    One place for every package version in the repository.

    Central package management keeps the version out of the project files: a project says what it
    needs, this file says which version satisfies it. That is what stops two projects from agreeing
    on a package name and disagreeing on its major version, the failure mode that only shows up as
    a runtime MissingMethodException much later.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!--
      One version for the four Microsoft.Extensions packages: the .NET 11 RC that the pinned SDK in
      global.json was built from. A newer one would exist only for a runtime this repository refuses to
      target, and an older one would be a .NET 10 library inside a net11.0 product.
    -->
    <DotNetExtensionsVersion>11.0.0-rc.2.26504.105</DotNetExtensionsVersion>
    <!-- One version for the six SharpCoreDB packages; see the comment on their rows below. -->
    <SharpCoreDBVersion>2.1.0-RC.3</SharpCoreDBVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      DI, HTTP and logging: the only Microsoft.Extensions packages the product needs.

      The version is the .NET 11 generation on purpose, and its build number (26504.105) is the one the
      pinned SDK in global.json carries. Mixing an 11.0.0-rc.2 host with a 10.0.x extension package is
      how a net11.0 product ends up shipping a net10.0 dependency graph: it builds, and then the two
      generations disagree at runtime. This repository targets net11.0 only, so its dependencies do too.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(DotNetExtensionsVersion)" />

    <!--
      SharpCoreDB 2.1.0-rc.3: the storage engine behind the code-evidence index (feature 002).
      One version for all six packages, because a mixed set would pit a vector column written by
      .VectorSearch against a planner from a different build. The packages are net11.0-only, which is
      the only framework this repository targets.

      They are published on nuget.org, so a clone restores them like any other dependency.
    -->
    <PackageVersion Include="SharpCoreDB" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.Search" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.VectorSearch" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.Graph" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.Graph.Advanced" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.HybridSearch" Version="$(SharpCoreDBVersion)" />

    <!--
      The approved-API snapshot analyzer (constitution, Principle VII). Dev-time only:
      PrivateAssets="all" keeps it out of every package and out of a consumer's build.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />

    <!-- xUnit v3 on the Microsoft.Testing.Platform: the same test stack as the sibling repositories. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.4.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
