<Project>

  <!--
    One place for every package version in the repository.

    Central package management keeps the version out of the project files: a project says what it
    needs, this file says which version satisfies it. That is what stops two projects from agreeing
    on a package name and disagreeing on its major version, the failure mode that only shows up as
    a runtime MissingMethodException much later.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!--
      One version for the four Microsoft.Extensions packages: the .NET 11 RC that the pinned SDK in
      global.json was built from. A newer one would track an SDK this repository does not pin, and an
      older one would be a .NET 10 library inside a net11.0 product.
    -->
    <DotNetExtensionsVersion>11.0.0-rc.2.26504.105</DotNetExtensionsVersion>
    <!-- One version for the six SharpCoreDB packages; see the comment on their rows below. -->
    <SharpCoreDBVersion>2.1.0</SharpCoreDBVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      DI, HTTP and logging: the only Microsoft.Extensions packages the product needs.

      The version is the .NET 11 generation on purpose, and its build number (26504.105) is the one the
      pinned SDK in global.json carries. Mixing an 11.0.0-rc.2 host with a 10.0.x extension package is
      how a net11.0 product ends up shipping a net10.0 dependency graph: it builds, and then the two
      generations disagree at runtime. This repository targets net11.0 and newer, so its dependencies
      start at that generation too.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(DotNetExtensionsVersion)" />

    <!--
      SharpCoreDB 2.1.0: the storage engine behind the code-evidence index (feature 002).
      One version for all six packages, because a mixed set would pit a vector column written by
      .VectorSearch against a planner from a different build. The packages are net11.0-only, which is
      the only framework this repository targets.

      They are published on nuget.org, so a clone restores them like any other dependency. 2.1.0 is
      the release; the RC.3 this file used to name is superseded. Two engine defects the RC.3 note
      recorded are still open in 2.1.0 — a bound float[] parameter is stored as the text
      "System.Single[]", and the SQL vector optimizer is never wired — because both were fixed after
      the tag (32227696, and fix/vector-sql-optimizer's 16cb51d5). The writer therefore keeps
      encoding vectors as JSON, and the vector leg stays in C#. What 2.1.0 did change is the shape a
      VECTOR(n) read hands back: a JsonElement for the stored JSON array, which IndexReader.AsVector
      accepts alongside the plain text RC.3 returned.
    -->
    <PackageVersion Include="SharpCoreDB" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.Search" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.VectorSearch" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.Graph" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.Graph.Advanced" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.HybridSearch" Version="$(SharpCoreDBVersion)" />

    <!--
      The approved-API snapshot analyzer (constitution, Principle VII). Dev-time only:
      PrivateAssets="all" keeps it out of every package and out of a consumer's build.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />

    <!--
      The SonarCloud rule set, in the build rather than only in the cloud. Pinned to the exact build the
      scanner provisions (csharpenterprise 10.35.0.4138), so a rule cannot be an error on a laptop and
      absent in an analysis, or the other way round.
    -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />

    <!--
      xUnit v3 on the Microsoft.Testing.Platform — Microsoft's own runner, no VSTest in the graph.

      There is deliberately no `Microsoft.NET.Test.Sdk` and no `xunit.runner.visualstudio`: both exist to
      make a test project look like a VSTest project, and this one is an executable that hosts MTP
      directly (`global.json` names the runner, so `dotnet test` uses it). VSTest data collectors are
      replaced by MTP's own coverage extension, which is why the test project reports coverage with a
      flag instead of an adapter.

      Versions move together: xunit.v3 names the MTP version it hosts, and a test project on a newer
      platform than its runner is how "the tests pass locally" and "the tests vanish in CI" diverge.
    -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

</Project>
