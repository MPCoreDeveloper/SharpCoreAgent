<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    One feed, and `<clear />` so a machine-level or user-level source cannot silently shadow it: a
    build that works on the author's machine and fails in CI is almost always a second feed.

    nuget.org serves every package this repository uses, including the six SharpCoreDB 2.1.0
    packages behind the code-evidence index. A developer who is working on SharpCoreDB itself can
    point `-p:SharpCoreAgentUseLocalSharpCoreDb=true` at a sibling checkout and get project references
    instead (see src/SharpCoreAgent.Indexing/SharpCoreAgent.Indexing.csproj), which needs no source
    entry here because MSBuild resolves project references before restore does.

    There is deliberately no package source mapping any more: it existed to tell two feeds apart, and
    a single feed has nothing to disambiguate.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
