<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Package source mapping, because this repository uses central package management and the machine
    that builds it may define more than one feed. Without a mapping NuGet cannot tell which feed is
    authoritative for a package id and refuses to guess (NU1507).

    nuget.org serves everything except the index engine. SharpCoreDB 2.1.0-RC.3 is a net11.0 preview
    line that has not been published, so it comes from the sibling SharpCoreDB checkout's artifacts
    folder. The only version that exists is the one in that folder, so `*` on nuget.org costs nothing:
    NuGet asks both feeds for a SharpCoreDB id and only the folder has 2.1.0-RC.3 to give.

    If the sibling checkout lives somewhere else, add a user-level source with the same
    `sharpcoredb-local` key (or drop the six .nupkg files into a folder and point this entry at it);
    the mapping follows the key, not the path.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="sharpcoredb-local" value="..\SharpCoreDB\artifacts" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="sharpcoredb-local">
      <package pattern="SharpCoreDB*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
